# Core / mesh
MUXCORE_GRPC_ADDR=localhost:9090
MUXCORE_INSECURE_DISABLE_TLS=true
MUXCORE_MESH_DIAL_LOCAL=true

# Module
MAINTAINER_DB_PATH=/var/lib/media-library-maintainer/maintainer.db
MAINTAINER_GRPC_ADDR=:9545
MAINTAINER_USERDATA_DIR=/var/lib/muxcore-userdata

# User erasure reconciler (ADR-0035): how often the identity ledger is read.
# household/staging profiles require MUXCORE_GRPC_ADDR above.
ERASURE_SWEEP_INTERVAL=5m

# Actions
MAINTAINER_MOVE_PATH=/archive/media
MAINTAINER_FREE_UP_ROOT=/data
MAINTAINER_ADD_LIST_EXCLUSION=false

# Jellyfin leaving-soon collections
JELLYFIN_BASE_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=
MAINTAINER_JELLYFIN_URL=
MAINTAINER_JELLYFIN_API_KEY=

# Plex leaving-soon collections
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=
MAINTAINER_PLEX_URL=
MAINTAINER_PLEX_TOKEN=
MAINTAINER_PLEX_MOVIE_SECTION=
MAINTAINER_PLEX_SHOW_SECTION=

# Servarr (history, exclusions, TV file paths)
RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=
SONARR_URL=http://127.0.0.1:8989
SONARR_API_KEY=

# Download clients (torrent cleanup after delete)
QBITTORRENT_URL=http://127.0.0.1:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=
MAINTAINER_QBITTORRENT_URL=
MAINTAINER_QBITTORRENT_USERNAME=
MAINTAINER_QBITTORRENT_PASSWORD=
MAINTAINER_QBITTORRENT_KEEP_DATA=false

TRANSMISSION_URL=http://127.0.0.1:9091/transmission/rpc
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=
MAINTAINER_TRANSMISSION_URL=
MAINTAINER_TRANSMISSION_USERNAME=
MAINTAINER_TRANSMISSION_PASSWORD=

DELUGE_URL=http://127.0.0.1:8112/json
DELUGE_PASSWORD=
MAINTAINER_DELUGE_URL=
MAINTAINER_DELUGE_PASSWORD=

# Ratings / exclusion lists
OMDB_API_KEY=
MAINTAINER_OMDB_API_KEY=
TRAKT_CLIENT_ID=
TRAKT_API_KEY=
MAINTAINER_TRAKT_CLIENT_ID=
MDBLIST_API_KEY=
MAINTAINER_MDBLIST_API_KEY=
MDBLIST_BASE_URL=https://mdblist.com/api

# JustWatch exclusion policies
JUSTWATCH_API_URL=

# Overlays & notifications
MAINTAINER_OVERLAY_ENABLED=false
MAINTAINER_OVERLAY_SHOW_DATE=true
MAINTAINER_OVERLAY_DATE_FORMAT=Jan 2
MAINTAINER_OVERLAY_TITLE_CARD=false
MAINTAINER_OVERLAY_TEMPLATE_JSON=
MAINTAINER_OVERLAY_IMAGE_DIR=
MAINTAINER_LEAVING_SOON_NOTIFY=true

# Requester protection
MAINTAINER_PROTECT_UNWATCHED_REQUESTERS=false
MAINTAINER_REQUEST_USER_MAP=
